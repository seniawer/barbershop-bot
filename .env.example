# Скопируйте этот файл в .env и впишите токен от @BotFather
BOT_TOKEN=

# Telegram ID администратора: ему приходят уведомления о записях и отменах.
# Свой ID можно узнать командой /id в боте. Если оставить пустым — уведомлений не будет
ADMIN_ID=

# Путь к файлу базы данных SQLite. Если оставить пустым — barbershop.db рядом с bot.py.
# Относительный путь считается от папки бота. На сервере можно указать, например:
# DB_PATH=/home/barbershop/data/barbershop.db
DB_PATH=
