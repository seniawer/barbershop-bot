# Скопируйте этот файл в .env и впишите токен от @BotFather
BOT_TOKEN=

# Telegram ID владельца: ему приходят уведомления о записях и отменах ко всем мастерам,
# а в меню мастера (/admin) видны все мастера. Свой ID можно узнать командой /id в боте.
# Telegram ID самих мастеров указываются в masters.json (поле telegram_id).
# Если оставить пустым — уведомления и меню мастера будут только у мастеров с telegram_id
ADMIN_ID=

# Путь к файлу базы данных SQLite. Если оставить пустым — barbershop.db рядом с bot.py.
# Относительный путь считается от папки бота. На сервере можно указать, например:
# DB_PATH=/home/barbershop/data/barbershop.db
DB_PATH=
