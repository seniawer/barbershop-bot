# systemd-служба для Telegram-бота барбершопа.
# Установка (подробно — в DEPLOY.md):
#   sudo cp deploy/barbershop-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now barbershop-bot
#
# Пути ниже рассчитаны на пользователя barbershop и папку /home/barbershop/barbershop-bot.
# Если у вас другие — поправьте User, Group, WorkingDirectory и ExecStart.

[Unit]
Description=Telegram-бот для записи в барбершоп
# Запускаться только когда на сервере уже есть сеть
After=network-online.target
Wants=network-online.target
# Не прекращать попытки перезапуска, даже если бот падает часто
StartLimitIntervalSec=0

[Service]
Type=simple
User=barbershop
Group=barbershop
WorkingDirectory=/home/barbershop/barbershop-bot
# Python из виртуального окружения: в нём установлены зависимости бота
ExecStart=/home/barbershop/barbershop-bot/.venv/bin/python bot.py
# Логи сразу попадают в journalctl, без задержки из-за буферизации
Environment=PYTHONUNBUFFERED=1

# Перезапуск при падении: через 5 секунд после любой остановки, кроме ручной
Restart=always
RestartSec=5

[Install]
# Автозапуск после перезагрузки сервера
WantedBy=multi-user.target
